# Single platform data root (conventions section 3). Required.
TRADEQ_DATA_DIR=/path/to/Tradeq/data
# Optional: alternative settings file.
# SIM_CONFIG_FILE=config/settings.yaml
# Any setting can be overridden, e.g.:
# SIM_SERVICE__PORT=8609
# SIM_CONTRACTS__PIT_BASE_URL=http://127.0.0.1:8603
# SIM_CONTRACTS__PIT_ENABLED=false
# SIM_CONTRACTS__FILLS_ROOT=/path/to/shadow-exchange/fills
# SIM_FEES__TAKER_BPS=4.0
# SIM_LOGGING__LEVEL=INFO
